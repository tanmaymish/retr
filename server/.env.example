# Heritage Ledger — server configuration.
# Copy to .env and fill in before running in production. In development the
# secrets below are generated per start, which is fine locally: restarting
# invalidates sessions and makes stored documents unreadable.

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ── Secrets ─────────────────────────────────────────────────────────────────
# Both are REQUIRED in production and the server refuses to start without them.
# Generate with: openssl rand -base64 48
#
# SESSION_SECRET signs session and CSRF tokens. Rotating it signs everyone out.
SESSION_SECRET=

# DOCUMENT_KEY is the master key every document key is derived from.
# LOSING THIS MEANS LOSING EVERY DOCUMENT — the ciphertext cannot be recovered
# without it. Back it up somewhere that is not this server.
DOCUMENT_KEY=

# ── Storage ─────────────────────────────────────────────────────────────────
# Database and encrypted documents. Mount this on a persistent volume.
DATA_DIR=data

# ── Deployment ──────────────────────────────────────────────────────────────
# Set when the app runs behind a reverse proxy that sets X-Forwarded-For.
# Leave off otherwise: it would let clients spoof their IP past the rate limits.
TRUST_PROXY=false

# Cookies. Secure must stay on in production; the server refuses to start if not.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=vault.example.com

# Only needed when the client is served from a different origin to the API.
# Left empty, CORS is off entirely — the intended production setup, where this
# server serves the built client itself.
# CORS_ORIGINS=https://vault.example.com

# Where the built client lives, relative to the repository root.
CLIENT_DIR=app/dist

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_IDLE_TTL_MINUTES=720
SESSION_ABSOLUTE_TTL_HOURS=336

# ── Accounts ────────────────────────────────────────────────────────────────
MIN_PASSWORD_LENGTH=12
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
# Set to false to close signups on a private deployment.
ALLOW_REGISTRATION=true

# ── Uploads ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENTS_PER_USER=200

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=10

LOG_LEVEL=info
